{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ProjectMind",
  "version": "0.1.1",
  "identifier": "com.xuchen.projectmind.alpha",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ProjectMind",
        "width": 1540,
        "height": 980,
        "minWidth": 736,
        "minHeight": 760,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "$TEMP/**",
            "$DOWNLOAD/**",
            "$DESKTOP/**",
            "$DOCUMENT/**",
            "$PICTURE/**",
            "$VIDEO/**",
            "$AUDIO/**",
            "$PUBLIC/**",
            "/Volumes/**"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5MzJCMTdEMTlDRDc1QTcKUldTbmRjMFpmYkV5MlpqcCt6UFhubXdFV2FZVlFvK2g1VE1pVGFUV0JDT0YzQzN3QXBVRjk4czcK",
      "endpoints": [
        "https://raw.githubusercontent.com/xuchen-cloud/project_mind/main/beta/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
