{
  "name": "@project-mind/dsh-assistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Project-scoped Node DSH runtime for the main app's embedded original chat components.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup": "npm ci --no-audit --no-fund",
    "build": "node scripts/desktop.mjs build",
    "dev": "node scripts/desktop.mjs dev",
    "start": "node scripts/desktop.mjs start",
    "check": "node scripts/desktop.mjs check",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node --test test/*.integration.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-base": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.2.0-rc.2",
    "@deepseek-ai/dsh-http-proxy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-app": "file:vendor/dsh-web-app",
    "dsh-desktop-client-ui": "file:vendor/dsh-desktop-client-ui"
  },
  "devDependencies": {
    "ws": "8.22.0"
  }
}
