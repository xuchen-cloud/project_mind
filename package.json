{
  "name": "project-mind-alpha",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420",
    "dev:tauri": "npm run prepare:cli:dev && tauri dev",
    "dev:tauri:manual": "npm run prepare:cli:dev && tauri dev --no-watch",
    "prepare:cli:dev": "cargo build --manifest-path src-tauri/Cargo.toml --bin mind --quiet",
    "dev:dsh": "npm --prefix packages/dsh-assistant run dev",
    "start:dsh": "npm --prefix packages/dsh-assistant run start",
    "build:dsh": "npm --prefix packages/dsh-assistant run build",
    "check:dsh": "npm --prefix packages/dsh-assistant run check",
    "test:dsh": "npm --prefix packages/dsh-assistant test",
    "test:dsh:integration": "npm --prefix packages/dsh-assistant run test:integration",
    "build": "npm run build:office && tsc && vite build",
    "build:record-worker": "vite build --config vite.record-worker.config.ts",
    "stage:record-runtime": "node scripts/stage-record-runtime.mjs",
    "build:desktop": "npm run prepare:desktop-runtime && tsc && vite build",
    "build:desktop:release": "npm run build:desktop && npm run prepare:cli",
    "prepare:cli": "node scripts/prepare-cli.mjs",
    "build:tauri": "tauri build --config src-tauri/tauri.release.conf.json",
    "prepare:desktop-runtime": "node scripts/prepare-desktop-runtime.mjs",
    "test:desktop-runtime": "node --test scripts/desktop-runtime.test.mjs scripts/stage-dsh-runtime.test.mjs",
    "build:icons": "tauri icon src-tauri/icons/icon-source.svg --output src-tauri/icons",
    "seed:demo": "cargo run --manifest-path src-tauri/Cargo.toml --bin seed_demo_data",
    "test:unit": "node scripts/patch-test-dom.mjs && vitest run",
    "test:unit:watch": "node scripts/patch-test-dom.mjs && vitest",
    "check:portable-paths": "node scripts/check-portable-paths.mjs",
    "check:ui-standards": "node scripts/check-ui-standards.mjs",
    "check:bundle-boundaries": "node scripts/check-bundle-boundaries.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:agent": "cargo test --manifest-path src-tauri/Cargo.toml --lib agent --quiet && vitest run src/services/agentApi.test.ts src/lib/queryKeys.test.ts && npm run build:record-worker && npm --prefix packages/agent-host run check && npm --prefix packages/agent-host test",
    "test:record": "npm run build:record-worker && npm run stage:record-runtime && vitest run src/lib/record-document.test.ts src/lib/record-document.node.test.ts src/lib/record-document-html.node.test.ts src/lib/record-patch.node.test.ts src/lib/record-version-compare.node.test.ts src/components/rich-editor/extensions/StableRecordBlocks.test.ts src/components/rich-editor/RichEditor.test.tsx src/components/rich-editor/noteImageAssets.test.ts src/lib/record-save-persistence.test.ts src/lib/record-save-coordinator.test.ts src/lib/record-save-runtime.test.tsx --maxWorkers=1 && npm --prefix packages/agent-host run test:record && cargo test --manifest-path src-tauri/Cargo.toml --lib record --quiet -- --include-ignored",
    "build:source-worker": "vite build --config vite.source-worker.config.ts",
    "stage:source-runtime": "node scripts/stage-source-runtime.mjs",
    "test:source": "npm run build:source-worker && vitest run src/lib/source-text.node.test.ts src/lib/source-pdf.node.test.ts src/workers/source-extraction-worker.node.test.ts --maxWorkers=1 && node --test packages/agent-host/test/source-worker.test.mjs",
    "build:office": "node scripts/build-office-runtime.mjs",
    "stage:office-runtime": "node scripts/stage-office-runtime.mjs",
    "test:office": "node --test packages/agent-host/test/office-worker.test.mjs && vitest run src/lib/office-edit-session.test.ts src/components/office/OfficeFileContent.test.tsx src/components/document/ProjectFileOffice.test.tsx src/components/document/ProjectFileMarkdown.test.tsx src/components/document/MarkdownFileContent.test.tsx src/components/document/ProjectFileContent.test.tsx src/components/project/ProjectContentWorkspace.test.tsx src/components/project/ProjectContentLayoutView.test.tsx --maxWorkers=1",
    "test:markdown": "npm --prefix packages/markdown-editor test",
    "test:office:formats": "npm --prefix packages/office-html2docx test && npm --prefix packages/office-docx test && npm --prefix packages/office-pptx test && npm --prefix packages/office-xlsx test && npm run test:markdown",
    "postinstall": "node scripts/patch-test-dom.mjs"
  },
